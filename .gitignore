.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Raw downloads stay local; preprocessed data and run evidence are shareable.
data/raw/*
!data/raw/.gitkeep

# Local report QA renders can be regenerated from the submitted DOCX.
reports/_rendered/
reports/_render_*/


# Regenerable local caches, not research evidence.
artifacts/recording_demos/*/matplotlib_cache/
